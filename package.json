{
  "name": "mosya-pop-message",
  "version": "1.0.0",
  "description": "Modern popup notification library with alerts, confirmations, prompts, toasts, and progress indicators",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "push": "git add . && git commit -m 'Build artifacts' && git push origin main"
  },
  "keywords": [
    "popup",
    "notification",
    "alert",
    "toast",
    "modal",
    "dialog",
    "confirmation",
    "prompt",
    "loading",
    "progress",
    "typescript"
  ],
  "author": "Mosya Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohdsyahid/mosya-pop-message.git"
  },
  "bugs": {
    "url": "https://github.com/mohdsyahid/mosya-pop-message/issues"
  },
  "homepage": "https://mohdsyahid.github.io/mosya-pop-message/",
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0",
    "terser": "^5.31.0"
  }
}
